# ============================================================
# ShinAI Configuration Example
# Copy this file to config.yaml and fill in your real values.
# NEVER commit config.yaml to git — it contains your secrets!
# ============================================================

# --- Platform ---
platform:
  telegram:
    enabled: true
    # Get these from https://my.telegram.org/apps
    api_id: "YOUR_API_ID"
    api_hash: "your_api_hash_here"
    # Get this from @BotFather on Telegram
    bot_token: "your_bot_token_here"
  discord:
    enabled: false
    # Get this from https://discord.com/developers/applications
    bot_token: "your_discord_token_here"
  whatsapp:
    enabled: false  # When enabled, scan the QR code printed on first run

# --- Admin ---
# Your primary user ID (Telegram or Discord) for admin-only commands
admin_user_id: 123456789

# --- Logging ---
logging:
  # INFO keeps the important interaction, tool, provider and lifecycle events.
  # DEBUG adds detailed decisions and timings without dumping secrets or full prompts.
  debug: false
  # Set to null to log only to stdout (recommended when a process manager captures logs).
  file: shinai_bot.log
  max_bytes: 25000000
  backup_count: 5
  # Number of user/response characters shown in normal interaction log lines. Use 0 to hide content.
  content_preview_chars: 120

# --- Response Timing ---
response:
  # Randomized delay before the bot responds
  # Multiple messages arriving during the delay are batched/queued
  min_delay_seconds: 5.0
  max_delay_seconds: 300.0
  # Random chance to respond to messages in group chats (0.05 = 5%)
  random_trigger_probability: 0.05
  # Max AI-generated responses per group chat within the window below
  # Prevents a single busy group from consuming all your API quota
  group_max_responses: 3
  group_rate_limit_window_seconds: 10.0

# --- Audio Transcription (Whisper) ---
whisper:
  # Recommended: large-v3-turbo (best quality-to-speed ratio, ~3GB RAM with int8)
  # Options: tiny | base | small | medium | large-v2 | large-v3-turbo
  model: large-v3-turbo
  # Transcription language: 'ar' for Arabic, 'en' for English, 'auto' to detect
  language: auto
  # Max CPU threads for Whisper inference (keep low on shared/weak servers)
  cpu_threads: 2
  # One inference at a time is normally fastest overall on a shared CPU and avoids workspace growth.
  max_concurrent_transcriptions: 1
  # A child process lets the OS fully reclaim Whisper's native memory after it becomes idle.
  process_isolation: true
  idle_timeout_seconds: 600
  # Kill and replace a stuck worker after this hard per-file deadline.
  timeout_seconds: 180
  # Reject oversized audio after download; only one download is retained at a time.
  max_file_bytes: 25000000

# --- Web Search (optional - fallback to duckduckgo if not configured) ---
# firecrawl:
#   api_key: "fc-your-key-here"

# Web Search Settings
web_search:
  # Total time budget (seconds) for a web search operation per user request
  timeout_seconds: 30.0

# --- Style Learning (optional) ---
# Telegram group ID to learn communication style from
# Get it by forwarding a message from the group to @RawDataBot
# style_group_id: "-1001234567890"

# --- Embeddings ---
# One shared, bounded service is used by memory, style, social context and time detection.
embedding:
  model: intfloat/multilingual-e5-large
  max_concurrency: 1
  batch_size: 16

# --- Runtime bounds ---
# These limits keep bursts from creating an unbounded number of tasks or retaining media in RAM.
runtime:
  max_concurrent_interactions: 24
  max_pending_interactions: 256
  per_chat_queue_size: 20
  interaction_ttl_seconds: 300
  shutdown_grace_seconds: 30
  # Native Discord/WhatsApp message objects can be large; keep only recent items.
  platform_message_cache_size: 500
  context:
    max_chats: 2000
    messages_per_chat: 50
    ttl_seconds: 7200

# --- Multi-instance coordination ---
# Instances that share a Gemini key pool MUST use the same namespace and the same absolute
# database_path. Platform credentials are fingerprinted separately, so instances with the
# same Telegram/Discord/WhatsApp account deduplicate events while different accounts do not.
# Use an absolute path when the two Python environments have different working directories.
coordination:
  backend: sqlite                 # sqlite for shared instances; memory for isolated development
  namespace: shinai-production   # short, human-readable coordination group name
  database_path: data/coordination.sqlite3
  lease_seconds: 240
  event_dedup_ttl_seconds: 86400
  cleanup_interval_seconds: 300

# --- AI ---
ai:
  # Per-attempt timeout (seconds) for a single AI provider call
  timeout_seconds: 60
  # Maximum retry attempts per provider before falling back to the next
  max_retries: 3
  # Hard total time budget (seconds) across ALL providers and retries for one request
  # After this limit the bot gives up on the request entirely
  global_timeout_seconds: 180.0

  # -------------------------------------------------------
  # Define as many providers as you like.
  # All non-Gemini providers use the OpenAI-compatible API
  # (works with OpenRouter, Groq, Cerebras, DeepSeek,
  #  Together AI, Fireworks, vLLM, Ollama, and more).
  # -------------------------------------------------------
  providers:
    # OpenRouter — access hundreds of models via one API
    - name: my_openrouter
      type: openai
      base_url: https://openrouter.ai/api/v1
      api_key: "sk-or-your-key-here"
      model: anthropic/claude-3.5-sonnet

    # Groq — ultra-fast inference
    - name: my_groq
      type: openai
      base_url: https://api.groq.com/openai/v1
      api_key: "gsk_your_key_here"
      model: llama-3.3-70b-versatile

    # Cerebras — fast inference
    - name: my_cerebras
      type: openai
      base_url: https://api.cerebras.ai/v1
      api_key: "csk_your_key_here"
      model: llama-3.3-70b

    # DeepSeek
    - name: my_deepseek
      type: openai
      base_url: https://api.deepseek.com
      api_key: "sk-your-deepseek-key-here"
      model: deepseek-chat

    # Local Ollama (no API key needed)
    - name: my_local_ollama
      type: openai
      base_url: http://localhost:11434/v1
      api_key: ollama          # Required by SDK but ignored by Ollama
      model: llama3.2
      concurrency: 1           # Limit to 1 concurrent call on CPU-bound hardware
    
    # Google Gemini
    - name: my_gemini
      type: gemini
      # API keys are managed in data/gemini_keys.json (supports many keys with rotation)
      # Optionally override which models to use:
      models:
        - gemini-3.5-flash
        - gemini-3-flash

  # Which provider to use as the primary (must match a name above)
  primary: my_openrouter

  # Ordered fallback providers (tried in sequence if primary fails)
  # Must match names defined above. Leave empty for no fallbacks.
  fallbacks:
    - my_gemini
    - my_groq
    - my_deepseek

  # How to rotate through providers:
  #   failover    — stick with primary; fall to next only on error/timeout (recommended)
  #   round_robin — cycle through all providers on every request
  rotation: failover
