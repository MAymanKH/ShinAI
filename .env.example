# ===========================================
# ShinAI Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# --- Telegram API Credentials ---
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_from_botfather

# --- Admin Configuration ---
# Your Telegram user ID (for admin-only commands)
ADMIN_USER_ID=your_telegram_user_id

# --- AI Provider Selection ---
# Options: gemini, openrouter, groq, cerebras, local, manual
AI_CHOICE=gemini

# --- Debug Mode ---
# Set to "true" to enable debug logging
DEBUG=false

# --- Gemini Configuration ---
# API keys are managed via data/gemini_keys.json after first run
# Or set them here for initial migration (GEMINI_API_KEY1, GEMINI_API_KEY2, etc.)
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter Configuration ---
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=your_preferred_model

# --- Groq Configuration ---
GROQ_API_KEY=your_groq_key
GROQ_MODEL=your_preferred_model

# --- Cerebras Configuration ---
CEREBRAS_API_KEY=your_cerebras_key

# --- Local LLM Configuration ---
LOCAL_MODEL=your_local_model_name
