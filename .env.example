# ===========================================
# ShinAI Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# --- Platform Controls ---
# Main platform toggles
TELEGRAM_ENABLED=true
DISCORD_ENABLED=true
WHATSAPP_ENABLED=false

# --- Telegram API Credentials ---
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# --- Discord API Credentials ---
# Get this from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_token_here

# If WhatsApp is enabled, you will be prompted to scan a QR code on first run to link your account

# --- Admin Configuration ---
# Your primary user ID (Telegram or Discord) for admin-only commands
ADMIN_USER_ID=your_user_id

# --- AI Provider Selection ---
# Options: gemini, openrouter, groq, cerebras, local
AI_CHOICE=gemini # recommended to use 'gemini' for visual understanding
# Optional comma-separated fallback providers (used if primary fails)
# Example: openrouter,groq
AI_FALLBACK_PROVIDERS=

# --- AI Provider Reliability ---
# Per-attempt timeout for AI provider calls (in seconds)
AI_PROVIDER_TIMEOUT_SECONDS=60
# Maximum AI call attempts per request
AI_PROVIDER_MAX_RETRIES=3

# --- Debug Mode ---
# Set to "true" to enable debug logging
DEBUG=false

# --- Response Configuration ---
# Randomized delay before the bot responds (in seconds)
# If multiple messages arrive during delay, they are queued
MIN_REPLY_DELAY_SECONDS=5.0
MAX_REPLY_DELAY_SECONDS=300.0
# Random chance to respond in group chats (0.05 = 5% chance per message)
RANDOM_TRIGGER_PROBABILITY=0.05

# --- Embedding Model ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large # Used for RAG indexing, retrieval and style learning

# --- Audio Transcription ---
# Recommended: large-v3-turbo (best quality-to-speed ratio, ~3GB RAM with int8)
# Other options: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3-turbo
# Max CPU threads for Whisper inference (keep low on shared servers)
WHISPER_CPU_THREADS=2
# Default language for transcription (e.g., 'ar' for Arabic, 'en' for English, or 'auto' for automatic detection)
WHISPER_LANGUAGE=auto

# --- Gemini Configuration ---
# API keys are managed via data/gemini_keys.json after first run
# Set them here for initial migration (GEMINI_API_KEY1, GEMINI_API_KEY2, etc.)
GEMINI_API_KEY1=your_gemini_key
# Comma-separated list of Gemini models to use (e.g., gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite)
GEMINI_MODELS=

# --- OpenRouter Configuration ---
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=your_preferred_model

# --- Groq Configuration ---
GROQ_API_KEY=your_groq_key
GROQ_MODEL=your_preferred_model

# --- Cerebras Configuration ---
CEREBRAS_API_KEY=your_cerebras_key
CEREBRAS_MODEL=

# --- Local LLM (Ollama) Configuration ---
LOCAL_MODEL=your_local_model_name

# --- Style Learning (Optional) ---
# Group ID to learn communication style from (Telegram)
# Get this by forwarding a message from the group to @RawDataBot
# STYLE_GROUP_ID=-1001234567890
